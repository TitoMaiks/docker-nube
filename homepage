services:
  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    environment:
      - HOMEPAGE_ALLOWED_HOSTS=192.168.1.56:3000
    ports:
      - 3000:3000
    volumes:
      - ./app/config:/app/config
      - ./var/run/docker.sock:/var/run/docker.sock
    restart: unless-stopped
