# Creamos carpeta:
mkdir mi-ia && cd mi-ia
nano docker-compose.yml

# Pegamos conf de docker-compose.yml
version: '3.8'

services:
  ollama:
    image: ollama/ollama
    container_name: ollama
    volumes:
      - ollama_data:/root/.ollama
    ports:
      - "11434:11434"
    restart: unless-stopped

  webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui
    ports:
      - "3000:8080"
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
    depends_on:
      - ollama
    restart: unless-stopped

volumes:
  ollama_data:

# Levantamos con "docker compose up" y entramos al puerto que hayamos configurado. Una vez verificado que funciona descargamos los modelos
docker exec -it ollama bash
ollama pull llama3
# Vemos si carga el modelo automaticamente o hace falta correrlo
ollama run llama3
